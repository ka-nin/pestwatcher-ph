PORT=8000
CORS_ORIGINS=http://localhost:5173,https://localhost:5173,http://localhost:5174,https://localhost:5174,http://localhost:5175,https://localhost:5175,http://localhost:19006,exp://localhost:19000
UPLOAD_DIR=uploads

# Signs LGU/superadmin auth tokens (app/security.py). Generate your own per
# environment — `openssl rand -base64 48` — never reuse the dev default.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRE_MINUTES=720

DATABASE_URL=postgresql+psycopg2://pestwatcher:pestwatcher_dev_only@localhost:5432/pestwatcher

# --- SMS advisories (app/sms/) ---
# console          = simulation: recorded in the outbox and logged, nothing sent
# android_gateway  = relay through "SMS Gateway for Android" (docs.sms-gate.app)
#                    running in Local Server mode on a handset, sending via its SIM
SMS_PROVIDER=console
# The handset's Local Server address. Use its Tailscale 100.x address so it
# works off the local Wi-Fi too. Port 8080 is the app's default.
SMS_GATEWAY_URL=
# Shown on the app's Local Server screen.
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
SMS_GATEWAY_TIMEOUT_SECONDS=15
# Bare local numbers (09171234567) are rewritten to this country code.
SMS_DEFAULT_COUNTRY_CODE=+63
